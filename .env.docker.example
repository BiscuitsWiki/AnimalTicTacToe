# 复制为 .env 后修改（docker compose 自动读取同目录 .env）

# 运营后台登录密钥（≥ 16 字符，否则服务端拒绝管理端鉴权；务必换成强随机值，如 PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
# ）
ADMIN_TOKEN=change-me-to-a-long-random-string

# Web 对外端口（默认 80。宿主机 80 被预装服务占用时改这里，如 8080，
# 并在云控制台防火墙放行对应端口，访问 http://IP:8080/）
# WEB_PORT=8080
